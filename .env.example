# Database
DATABASE_URL=sqlite+aiosqlite:///./chemistry.db

# Artifacts storage directory
ARTIFACTS_DIR=./artifacts/videos

# LLM Providers (set at least one)
# Primary: Codex (OpenAI-compatible, e.g. Ollama)
CODEX_API_BASE=http://localhost:11434/v1
CODEX_API_KEY=no-key-needed
CODEX_MODEL=qwen2.5:7b

# Fallback: Anthropic Claude Haiku
ANTHROPIC_API_KEY=

# Pipeline settings
MAX_RETRIES=2
MAX_CONCURRENT_JOBS=2
